# Never commit real values. Use a self-operated SMTP host when provisioned.
NODE_ENV=production
PORT=8788
INTERNAL_SERVICE_TOKEN=replace-with-a-distinct-32-byte-random-token
EVENT_INGEST_TOKEN=replace-with-a-separate-32-byte-random-token
# One-time first-owner bootstrap token. After bootstrap, individual operator sessions protect all /v1/admin endpoints.
ADMIN_TOKEN=replace-with-a-separate-32-byte-random-token
QUEUE_DB_PATH=./data/mail-queue.sqlite
# Generate 32 random bytes and base64-encode them. Keep this key backed up securely.
QUEUE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
SMTP_HOST=mail.your-domain.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=luxora-verify
SMTP_PASSWORD=replace-with-secret
MAIL_FROM=verify@your-domain.example
MAIL_FROM_NAME=LUXORA VERIFY
BOUNCE_ADDRESS=bounces@your-domain.example
